VITE_API_BASE_URL=
VITE_USE_DEMO_DATA=false
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_DEFAULT_COUNTRY=BR
VITE_DEV_API_PROXY_TARGET=http://localhost:8082

ANGICO_DB_URL=jdbc:h2:mem:angico;DB_CLOSE_DELAY=-1
ANGICO_DB_USER=sa
ANGICO_DB_PASSWORD=
ANGICO_ALLOWED_ORIGINS=http://localhost:5175
ANGICO_AUTH_REQUIRED=true
ANGICO_SEED_LEADERS_ENABLED=true
ANGICO_SEED_LEADER_PASSWORD=troque-esta-senha
ANGICO_UPLOAD_DIR=uploads
ANGICO_UPLOAD_MAX_BYTES=2097152
ANGICO_UPLOAD_MAX_FILE_SIZE=2MB
ANGICO_UPLOAD_MAX_REQUEST_SIZE=8MB
ANGICO_UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,application/pdf,text/plain
ANGICO_GEOCODER_PROVIDER=nominatim
ANGICO_GEOCODER_USER_AGENT=Angico/0.1 contact@example.com
SERVER_PORT=8082
