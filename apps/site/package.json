{
  "name": "angico-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5175",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "check": "npm run lint && npm run typecheck && npm test -- --run",
    "build": "npm run typecheck && vite build",
    "budget": "node scripts/check-bundle-budget.mjs",
    "test:budget": "node --test scripts/check-bundle-budget.test.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4175",
    "test": "vitest",
    "e2e": "playwright test",
    "verify": "npm run check && npm run test:budget && npm run e2e && npm run budget"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "5.2.10",
    "@fontsource/dm-sans": "5.2.8",
    "@fontsource/space-mono": "5.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.10"
  }
}
