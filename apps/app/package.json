{
  "name": "angico-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5176",
    "build": "tsc && vite build",
    "budget": "node scripts/check-bundle-budget.mjs",
    "check": "npm run lint && npm run typecheck && npm test -- --run",
    "e2e": "playwright test",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview --host 0.0.0.0 --port 4176",
    "test": "vitest",
    "test:budget": "node --test scripts/check-bundle-budget.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run check && npm run test:budget && npm run e2e && npm run budget"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "5.2.10",
    "@fontsource/dm-sans": "5.2.8",
    "@fontsource/space-mono": "5.2.9",
    "idb": "^8.0.3",
    "leaflet": "^1.9.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "7.18.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "17.7.0",
    "jsdom": "^29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.0",
    "vitest": "^4.1.10"
  }
}
